# ============================================================
# 环境变量清单（部署配置说明书）
# 用法：复制本文件为 .env，填入真实值后注入环境变量
# 注意：Spring Boot 不会自动读取 .env 文件，它只认系统环境变量；
#       .env 的真正用法是 docker-compose 的 env_file 自动加载（阶段二）。
# ============================================================

# ---------- 数据库 ----------
# 本地开发保持 localhost；部署时把 localhost 换成数据库主机（如 db）
DB_URL=jdbc:mysql://localhost:3306/interview_helper?useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=你的数据库密码

# ---------- DeepSeek 大模型 ----------
# API_KEY 在 https://platform.deepseek.com 申请
API_KEY=sk-xxxx
BASE_URL=https://api.deepseek.com

# ---------- JWT ----------
# 随机 Base64 字符串，可用 PowerShell 生成：
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# 妥善保管，不要把真实值提交进 git
JWT_SECRET=随机生成

# ---------- CORS 跨域白名单 ----------
# 允许访问后端的前端来源，多个用逗号分隔
# 本地开发不用改（前端走 Vite 代理同源）；上线时填真实前端域名
CORS_ALLOWED_ORIGINS=http://localhost:5173
